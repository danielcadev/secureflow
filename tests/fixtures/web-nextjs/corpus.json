{
  "contract_version": "secureflow-web-development-corpus-v1",
  "corpus_id": "sf_web_corpus_db8f1e502692d734e58c6279226ce916860c9341b73a1dd046890318201ca6f4",
  "name": "SecureFlow synthetic Next.js development assertions v1",
  "split": "development",
  "license": {
