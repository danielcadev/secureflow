{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secureflow.dev/schemas/secureflow-catalog-trust-policy-v1.schema.json",
  "title": "secureflow-catalog-trust-policy-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "publisher_id",
    "publisher_label",
    "catalog_id",
    "channel",
    "profiles",
    "initial_root_sha256",
    "minimum_root_version",
    "minimum_sequence",
    "bootstrap_manifest_sha256",
    "minimum_thresholds",
    "maximum_horizon_days",
    "operator",
    "authorization_reference",
    "enrolled_at"
  ],
  "properties": {
    "contract_version": {
      "const": "secureflow-catalog-trust-policy-v1"
    },
    "publisher_id": {
      "$ref": "#/$defs/identifier"
    },
    "publisher_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "catalog_id": {
      "$ref": "#/$defs/identifier"
    },
    "channel": {
      "$ref": "#/$defs/identifier"
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profile"
      },
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true
    },
    "initial_root_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "minimum_root_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "minimum_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "bootstrap_manifest_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "minimum_thresholds": {
      "const": {
        "root": 2,
        "targets": 2,
        "snapshot": 1,
        "timestamp": 1
      }
    },
    "maximum_horizon_days": {
      "const": {
        "root": 366,
        "targets": 30,
        "snapshot": 30,
        "timestamp": 7
      }
    },
    "operator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "authorization_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "enrolled_at": {
      "$ref": "#/$defs/clock"
    }
  },
  "$defs": {
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_time",
        "time_source",
        "time_reference"
      ],
      "properties": {
        "verification_time": {
          "$ref": "#/$defs/utc"
        },
        "time_source": {
          "enum": [
            "operator-attested",
            "operator-trusted-system-clock"
          ]
        },
        "time_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "profile": {
      "enum": [
        "core",
        "malicious",
        "full"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "format": "date-time"
    }
  }
}
