{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secureflow.dev/schemas/secureflow-company-discovery-v1.schema.json",
  "description": "Structural contract only; runtime enforces canonical identities, references, quotas and storage integrity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "sources",
    "assets"
  ],
  "properties": {
    "contract_version": {
      "const": "secureflow-company-discovery-v1"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "reference_url",
          "content_sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "kind": {
            "enum": [
              "official-site",
              "scope-policy",
              "github-metadata",
              "certificate-transparency",
              "dns-record",
              "agent-search"
            ]
          },
          "reference_url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "format": "uri"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "value",
          "source_ids",
          "relations",
          "limitations"
        ],
        "properties": {
          "kind": {
            "enum": [
              "domain",
              "origin",
              "repository",
              "endpoint"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            }
          },
          "relations": {
            "type": "array",
            "minItems": 0,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "target_id"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "references",
                    "deployed-on",
                    "contains",
                    "candidate-subdomain"
                  ]
                },
                "target_id": {
                  "type": "string",
                  "pattern": "^sf_asset_[a-f0-9]{64}$"
                }
              }
            }
          },
          "limitations": {
            "type": "array",
            "minItems": 0,
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      }
    }
  }
}
