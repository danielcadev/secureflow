{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SecureFlow dynamic result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "status",
    "plan_sha256",
    "actions_approved",
    "actions_attempted",
    "actions_completed",
    "requests_used",
    "observations",
    "failure",
    "human_decisions",
    "provider_calls",
    "ai_reasoning",
    "final_authority"
  ],
  "properties": {
    "contract_version": {
      "const": "secureflow-dynamic-result-v1"
    },
    "status": {
      "enum": [
        "running",
        "completed",
        "failed",
        "incomplete"
      ]
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "actions_approved": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "actions_attempted": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    },
    "actions_completed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    },
    "requests_used": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    },
    "observations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "principal_id",
          "path",
          "status_code",
          "body_bytes",
          "body_sha256",
          "expected_status",
          "outcome"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "principal_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "path": {
            "type": "string",
            "maxLength": 1024,
            "pattern": "^/(?:[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*/?)?$"
          },
          "status_code": {
            "type": "integer",
            "minimum": 100,
            "maximum": 999
          },
          "body_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65536
          },
          "body_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "expected_status": {
            "type": "integer",
            "minimum": 200,
            "maximum": 499
          },
          "outcome": {
            "enum": [
              "status-matched",
              "status-mismatched",
              "inconclusive"
            ]
          }
        }
      }
    },
    "failure": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "action_id"
          ],
          "properties": {
            "code": {
              "enum": [
                "authorization_expired",
                "run_budget_exhausted",
                "request_budget_exhausted",
                "identity_mismatch",
                "request_timeout",
                "redirect_refused",
                "response_too_large",
                "transport_failed",
                "evidence_write_failed"
              ]
            },
            "action_id": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                }
              ]
            }
          }
        }
      ]
    },
    "human_decisions": {
      "const": 0
    },
    "provider_calls": {
      "const": 0
    },
    "ai_reasoning": {
      "const": "external-client-not-measured"
    },
    "final_authority": {
      "const": "human-only"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "failure": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "failure": {
            "type": "null"
          }
        }
      }
    }
  ]
}
