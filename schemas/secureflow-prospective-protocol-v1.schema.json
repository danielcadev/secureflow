{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secureflow.local/schemas/secureflow-prospective-protocol-v1.schema.json",
  "title": "SecureFlow sealed prospective study protocol v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "protocol_id", "sealed_at", "research_question", "corpus", "systems", "blinding", "execution", "outcomes", "claims"],
  "properties": {
    "contract_version": { "const": "secureflow-prospective-protocol-v1" },
    "protocol_id": { "type": "string", "pattern": "^sf_protocol_[0-9a-f]{64}$" },
    "sealed_at": { "type": "string", "format": "date-time" },
    "research_question": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "provenance_sha256", "license_manifest_sha256", "total_cases", "vulnerable_cases", "safe_controls", "languages", "weakness_families", "previously_unseen_holdout", "labels_hidden_from_systems"],
      "properties": {
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "provenance_sha256": { "$ref": "#/$defs/sha256" },
        "license_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "total_cases": { "type": "integer", "minimum": 20 },
        "vulnerable_cases": { "type": "integer", "minimum": 10 },
        "safe_controls": { "type": "integer", "minimum": 10 },
        "languages": { "$ref": "#/$defs/nonemptyStrings" },
        "weakness_families": { "$ref": "#/$defs/nonemptyStrings" },
        "previously_unseen_holdout": { "const": true },
        "labels_hidden_from_systems": { "const": true }
      }
    },
    "systems": {
      "type": "array",
      "minItems": 2,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["system_id", "kind", "version_or_cohort", "configuration_sha256", "capability_profile"],
        "properties": {
          "system_id": { "type": "string", "minLength": 1, "maxLength": 100 },
          "kind": { "enum": ["secureflow", "automated-comparator", "human-researcher"] },
          "version_or_cohort": { "type": "string", "minLength": 1, "maxLength": 200 },
          "configuration_sha256": { "$ref": "#/$defs/sha256" },
          "capability_profile": { "$ref": "#/$defs/nonemptyStrings" }
        }
      }
    },
    "blinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participant_ground_truth_hidden", "system_ground_truth_hidden", "randomized_case_order", "independent_adjudicators", "disagreement_resolution", "leakage_audit_required"],
      "properties": {
        "participant_ground_truth_hidden": { "const": true },
        "system_ground_truth_hidden": { "const": true },
        "randomized_case_order": { "const": true },
        "independent_adjudicators": { "type": "integer", "minimum": 2 },
        "disagreement_resolution": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "leakage_audit_required": { "const": true }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repetitions_per_automated_system", "timeout_seconds_per_case", "equal_machine_resource_limits", "network_policy", "retry_policy", "crash_timeout_policy", "environment_sha256"],
      "properties": {
        "repetitions_per_automated_system": { "type": "integer", "minimum": 1, "maximum": 100 },
        "timeout_seconds_per_case": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "equal_machine_resource_limits": { "const": true },
        "network_policy": { "enum": ["disabled", "recorded-required"] },
        "retry_policy": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "crash_timeout_policy": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "environment_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_metrics", "report_precision_recall_separately", "report_false_positives_negatives_separately", "report_time_and_cost", "report_abstentions", "uncertainty_method", "success_criterion"],
      "properties": {
        "primary_metrics": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["validated-recall", "validated-precision", "false-positive-rate", "analyst-minutes", "wall-clock-seconds", "token-cost"] }
        },
        "report_precision_recall_separately": { "const": true },
        "report_false_positives_negatives_separately": { "const": true },
        "report_time_and_cost": { "const": true },
        "report_abstentions": { "const": true },
        "uncertainty_method": { "type": "string", "minLength": 1, "maxLength": 500 },
        "success_criterion": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_bounded_comparison_only", "no_global_superiority_claim", "no_production_safety_claim", "publish_negative_results", "disclose_conflicts_and_limitations"],
      "properties": {
        "task_bounded_comparison_only": { "const": true },
        "no_global_superiority_claim": { "const": true },
        "no_production_safety_claim": { "const": true },
        "publish_negative_results": { "const": true },
        "disclose_conflicts_and_limitations": { "const": true }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  }
}
