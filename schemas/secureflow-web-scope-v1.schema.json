{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secureflow.local/schemas/secureflow-web-scope-v1.schema.json",
  "title": "SecureFlow Web authorized offline scope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "scope_id", "created_at", "authorization", "repositories", "assets", "policy", "limits"],
  "properties": {
    "contract_version": { "const": "secureflow-web-scope-v1" },
    "scope_id": { "type": "string", "pattern": "^sf_web_scope_[0-9a-f]{64}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reference", "reviewer", "expires_at"],
      "properties": {
        "status": { "const": "authorized" },
        "reference": { "type": "string", "minLength": 1, "maxLength": 300 },
        "reviewer": { "type": "string", "minLength": 1, "maxLength": 200 },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "root_sha256"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 200 },
          "root_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "value", "include_subdomains", "schemes", "ports"],
        "properties": {
          "kind": { "enum": ["dns-name", "ip-address"] },
          "value": { "type": "string", "minLength": 1, "maxLength": 253 },
          "include_subdomains": { "type": "boolean" },
          "schemes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": { "enum": ["http", "https"] }
          },
          "ports": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passive_only", "network_execution", "follow_redirects", "third_party_scanning"],
      "properties": {
        "passive_only": { "const": true },
        "network_execution": { "const": "disabled" },
        "follow_redirects": { "const": false },
        "third_party_scanning": { "const": false }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_files", "max_file_bytes", "max_total_bytes", "max_routes", "max_sources", "max_requests", "requests_per_minute", "max_concurrency"],
      "properties": {
        "max_files": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "max_file_bytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "max_total_bytes": { "type": "integer", "minimum": 1, "maximum": 17179869184 },
        "max_routes": { "type": "integer", "minimum": 1, "maximum": 2000000 },
        "max_sources": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "max_requests": { "const": 0 },
        "requests_per_minute": { "const": 0 },
        "max_concurrency": { "const": 0 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
