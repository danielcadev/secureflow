{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usesecure.dev/secureflow/schemas/secureflow-knowledge-record-v1.schema.json",
  "title": "SecureFlow Knowledge Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "record_id",
    "manifest_sha256",
    "manifest_created_at",
    "target_sha256",
    "engine_name",
    "engine_version",
    "engine_binary_sha256",
    "finding_id",
    "title",
    "rule_id",
    "confidence",
    "source_location",
    "sink_location",
    "invariant",
    "evidence_path",
    "decision",
    "reviewer",
    "reviewed_at",
    "rationale_sha256"
  ],
  "properties": {
    "record_version": { "const": "secureflow-knowledge-record-v1" },
    "record_id": { "type": "string", "pattern": "^sf_kb_[a-f0-9]{64}$" },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "manifest_created_at": { "type": "string", "format": "date-time" },
    "target_sha256": { "$ref": "#/$defs/sha256" },
    "engine_name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "engine_version": { "type": "string", "minLength": 1, "maxLength": 100 },
    "engine_binary_sha256": { "$ref": "#/$defs/sha256" },
    "finding_id": { "type": "string", "pattern": "^sf_finding_[A-Za-z0-9_-]{16,100}$" },
    "engine_fingerprint": { "type": "string", "maxLength": 200 },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "rule_id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "taxonomy": { "$ref": "#/$defs/taxonomy" },
    "severity": { "enum": ["critical", "high", "medium", "low", "unknown"] },
    "confidence": { "enum": ["high", "medium", "low", "unknown"] },
    "source_location": { "$ref": "#/$defs/location" },
    "sink_location": { "$ref": "#/$defs/location" },
    "invariant": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "evidence_path": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence_step" }
    },
    "decision": { "enum": ["validated", "rejected", "abstained"] },
    "reviewer": { "type": "string", "minLength": 1, "maxLength": 200 },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "rationale_sha256": { "$ref": "#/$defs/sha256" },
    "evidence_reference_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start_line", "start_column"],
      "properties": {
        "path": { "$ref": "#/$defs/relative_path" },
        "start_line": { "type": "integer", "minimum": 1 },
        "start_column": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "end_column": { "type": "integer", "minimum": 1 }
      }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "category_id", "invariant_id"],
      "properties": {
        "version": { "type": "string", "minLength": 1, "maxLength": 50 },
        "category_id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "invariant_id": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "evidence_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "location", "description"],
      "properties": {
        "kind": {
          "enum": ["source", "transform", "guard", "sanitizer", "authorization", "sink", "barrier", "unknown"]
        },
        "location": { "$ref": "#/$defs/location" },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    }
  }
}
