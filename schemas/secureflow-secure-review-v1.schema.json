{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usesecure.dev/secureflow/schemas/secureflow-secure-review-v1.schema.json",
  "title": "SecureFlow Secure Skill Contextual Review v1",
  "description": "A provenance-bound import of Secure Skill review-contract 1.1. Findings are contextual candidates and only a human can validate them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "import_id",
    "imported_at",
    "linked_run_id",
    "target_sha256",
    "payload_sha256",
    "payload_bytes",
    "source",
    "semantics",
    "review"
  ],
  "properties": {
    "contract_version": { "const": "secureflow-secure-review-v1" },
    "import_id": { "type": "string", "pattern": "^sf_secure_review_[a-f0-9]{64}$" },
    "imported_at": { "type": "string", "format": "date-time" },
    "linked_run_id": { "type": "string", "pattern": "^sf_run_[A-Za-z0-9_-]{16,80}$" },
    "target_sha256": { "$ref": "#/$defs/sha256" },
    "payload_sha256": { "$ref": "#/$defs/sha256" },
    "payload_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
    "source": { "$ref": "#/$defs/source" },
    "semantics": { "$ref": "#/$defs/semantics" },
    "review": { "$ref": "#/$defs/review" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "revision",
        "skill_sha256",
        "review_contract_schema",
        "review_contract_sha256",
        "license_spdx",
        "license_sha256"
      ],
      "properties": {
        "name": { "const": "secure-skill" },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "revision": {
          "type": "string",
          "oneOf": [
            { "pattern": "^[a-f0-9]{40}$" },
            { "pattern": "^[a-f0-9]{64}$" }
          ]
        },
        "skill_sha256": { "$ref": "#/$defs/sha256" },
        "review_contract_schema": { "const": "1.1" },
        "review_contract_sha256": { "$ref": "#/$defs/sha256" },
        "license_spdx": { "type": "string", "minLength": 1, "maxLength": 100 },
        "license_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imported_findings_are", "validation_authority", "no_findings_mean_safe"],
      "properties": {
        "imported_findings_are": { "const": "contextual-candidates" },
        "validation_authority": { "const": "human-only" },
        "no_findings_mean_safe": { "const": false }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "mode",
        "scope",
        "findings",
        "verification",
        "coverage",
        "residual_risk"
      ],
      "properties": {
        "schema_version": { "const": "1.1" },
        "mode": { "enum": ["review", "diff-review", "audit", "threat-model", "fix", "verify"] },
        "authorization": { "enum": ["read-only", "explicit"] },
        "scope": { "$ref": "#/$defs/scope" },
        "findings": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/finding" }
        },
        "non_findings": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/non_finding" }
        },
        "verification": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/verification" }
        },
        "coverage": { "$ref": "#/$defs/coverage" },
        "residual_risk": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/text_4000" }
        },
        "threat_model": { "type": "object" },
        "remediation": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "fix" } }, "required": ["mode"] },
          "then": {
            "required": ["authorization", "remediation"],
            "properties": { "authorization": { "const": "explicit" } }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "threat-model" } }, "required": ["mode"] },
          "then": { "required": ["threat_model"] }
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "basis", "exclusions"],
      "properties": {
        "paths": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/relative_path" }
        },
        "basis": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "exclusions": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/relative_path" }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "confidence",
        "title",
        "location",
        "evidence",
        "invariant",
        "source_to_sink",
        "attacker_path",
        "impact",
        "prerequisites",
        "recommendation",
        "verification_status",
        "residual_risk"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^SEC-[0-9]{3,20}$" },
        "severity": { "enum": ["critical", "high", "medium", "low"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "location": { "$ref": "#/$defs/location" },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "invariant": { "$ref": "#/$defs/text_4000" },
        "source_to_sink": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "attacker_path": { "$ref": "#/$defs/attacker_path" },
        "impact": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "prerequisites": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/text_4000" }
        },
        "recommendation": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "verification_status": { "enum": ["verified", "unverified", "fixed", "retest-failed", "not-applicable"] },
        "residual_risk": { "type": "string", "minLength": 1, "maxLength": 10000 }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line", "symbol"],
      "properties": {
        "file": { "$ref": "#/$defs/relative_path" },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "symbol": { "type": ["string", "null"], "minLength": 1, "maxLength": 500 }
      }
    },
    "attacker_path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "required_access",
        "controlled_input",
        "victim_action",
        "steps",
        "achieved_result",
        "limitations"
      ],
      "properties": {
        "actor": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "required_access": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/text_4000" }
        },
        "controlled_input": { "$ref": "#/$defs/text_4000" },
        "victim_action": { "$ref": "#/$defs/text_4000" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/text_4000" }
        },
        "achieved_result": { "$ref": "#/$defs/text_4000" },
        "limitations": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/text_4000" }
        }
      }
    },
    "non_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "title", "evidence", "missing_gate", "next_step"],
      "properties": {
        "classification": { "enum": ["unverified-lead", "hardening", "correctness", "compatibility-question"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "missing_gate": { "$ref": "#/$defs/text_4000" },
        "next_step": { "$ref": "#/$defs/text_4000" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "status", "summary"],
      "properties": {
        "check": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "status": { "enum": ["passed", "failed", "not-run", "blocked"] },
        "summary": { "$ref": "#/$defs/text_4000" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewed", "not_reviewed"],
      "properties": {
        "reviewed": {
          "type": "array",
          "maxItems": 10000,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        },
        "not_reviewed": {
          "type": "array",
          "maxItems": 10000,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    },
    "text_4000": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  }
}
