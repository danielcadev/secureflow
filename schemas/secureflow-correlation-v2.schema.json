{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secureflow.local/schemas/secureflow-correlation-v2.schema.json",
  "title": "SecureFlow conservative package and version correlation v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "correlation_id", "created_at", "linked_run", "package_context", "catalog", "semantics", "version_summary", "advisories"],
  "properties": {
    "contract_version": { "const": "secureflow-correlation-v2" },
    "correlation_id": { "type": "string", "pattern": "^sf_correlation_[0-9a-f]{64}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "linked_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "manifest_sha256", "finding_id", "human_decision"],
      "properties": {
        "run_id": { "type": "string", "pattern": "^sf_run_[A-Za-z0-9_-]{16,80}$" },
        "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "finding_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "human_decision": { "enum": ["pending", "validated", "rejected", "abstained"] }
      }
    },
    "package_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion", "ecosystem", "name"],
      "properties": {
        "assertion": { "const": "operator-supplied-exact-package-context" },
        "ecosystem": { "type": "string", "minLength": 1, "maxLength": 100 },
        "name": { "type": "string", "minLength": 1, "maxLength": 512 },
        "version": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "complete_snapshot_ids", "canonicalization", "last_canonical_rebuild_id"],
      "properties": {
        "schema_version": { "type": "integer", "minimum": 1 },
        "complete_snapshot_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^sf_snapshot_[0-9a-f]{64}$" }
        },
        "complete_delta_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^sf_delta_[0-9a-f]{64}$" }
        },
        "canonicalization": { "type": "string", "minLength": 1 },
        "last_canonical_rebuild_id": {
          "type": ["string", "null"],
          "pattern": "^sf_canonical_[0-9a-f]{64}$"
        }
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["advisory_match_kind", "version_evaluator", "affected_version_evaluated", "version_result_validates_vulnerability", "causal_relationship_asserted", "changes_human_decision", "validation_authority"],
      "properties": {
        "advisory_match_kind": { "const": "exact-ecosystem-package-with-osv-version-evaluation" },
        "version_evaluator": { "const": "osv-semver-and-enumerated-v1" },
        "affected_version_evaluated": { "type": "boolean" },
        "version_result_validates_vulnerability": { "const": false },
        "causal_relationship_asserted": { "const": false },
        "changes_human_decision": { "const": false },
        "validation_authority": { "const": "human-only" }
      }
    },
    "version_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["affected", "not_affected", "unknown", "not_evaluated"],
      "properties": {
        "affected": { "type": "integer", "minimum": 0 },
        "not_affected": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 },
        "not_evaluated": { "type": "integer", "minimum": 0 }
      }
    },
    "advisories": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["canonical_id", "source_name", "source_record_id", "title", "modified_at", "withdrawn", "version_assessment"],
        "properties": {
          "canonical_id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "source_name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "source_record_id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "title": { "type": "string", "maxLength": 16384 },
          "modified_at": { "type": "string", "format": "date-time" },
          "withdrawn": { "type": "boolean" },
          "version_assessment": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "basis", "evaluated_version", "matched_value", "affected_data_sha256", "issues"],
            "properties": {
              "status": { "enum": ["not-evaluated", "affected", "not-affected", "unknown"] },
              "basis": { "enum": ["not-requested", "exact-enumerated-version", "osv-semver-range", "supported-data-excludes-version", "unsupported-or-invalid-data"] },
              "evaluated_version": { "type": ["string", "null"], "maxLength": 256 },
              "matched_value": { "type": ["string", "null"], "maxLength": 500 },
              "affected_data_sha256": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              },
              "issues": {
                "type": "array",
                "uniqueItems": true,
                "items": { "enum": ["invalid-query-semver", "invalid-stored-json", "invalid-semver-events", "missing-version-data", "unsupported-range-type"] }
              }
            }
          }
        }
      }
    }
  }
}
