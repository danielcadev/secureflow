{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secureflow.local/schemas/secureflow-web-inventory-v1.schema.json",
  "title": "SecureFlow Web deterministic inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "inventory_id", "generated_at", "scope_id", "repository_root_sha256", "sources", "routes", "issues", "stats", "semantics"],
  "properties": {
    "contract_version": { "const": "secureflow-web-inventory-v1" },
    "inventory_id": { "type": "string", "pattern": "^sf_web_inventory_[0-9a-f]{64}$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "scope_id": { "type": "string", "pattern": "^sf_web_scope_[0-9a-f]{64}$" },
    "repository_root_sha256": { "$ref": "#/$defs/sha256" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/source" }
    },
    "routes": {
      "type": "array",
      "maxItems": 2000000,
      "items": { "$ref": "#/$defs/route" }
    },
    "issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/issue" }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files_seen", "files_read", "bytes_read", "routes", "symlinks_skipped", "truncated"],
      "properties": {
        "files_seen": { "type": "integer", "minimum": 0 },
        "files_read": { "type": "integer", "minimum": 0 },
        "bytes_read": { "type": "integer", "minimum": 0 },
        "routes": { "type": "integer", "minimum": 0 },
        "symlinks_skipped": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" }
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_used", "target_code_executed", "unknown_controls_are_safe", "undocumented_means_vulnerable"],
      "properties": {
        "network_used": { "const": false },
        "target_code_executed": { "const": false },
        "unknown_controls_are_safe": { "const": false },
        "undocumented_means_vulnerable": { "const": false }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "kind", "name", "revision", "sha256", "license_spdx"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^sf_web_source_[0-9a-f]{64}$" },
        "kind": { "enum": ["repository", "build-manifest", "open-api", "graph-ql", "trpc", "authorized-log", "simulated-dns", "simulated-certificate-transparency"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "revision": { "type": "string", "minLength": 1, "maxLength": 200 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "license_spdx": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "framework", "kind", "method_evidence", "methods", "parameters", "presence", "controls", "response_fields", "source", "evidence", "limitations"],
      "properties": {
        "route_id": { "type": "string", "pattern": "^sf_web_route_[0-9a-f]{64}$" },
        "framework": { "enum": ["next-app-router", "next-pages-router", "next-shared"] },
        "kind": { "enum": ["api-route", "page-route", "middleware", "server-action"] },
        "method_evidence": { "enum": ["declared-export", "framework-default", "unknown", "not-applicable"] },
        "methods": {
          "type": "array",
          "maxItems": 7,
          "uniqueItems": true,
          "items": { "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"] }
        },
        "route": { "type": "string", "pattern": "^/", "maxLength": 2000 },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "location", "required", "catch_all"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 300 },
              "location": { "enum": ["path", "query", "body", "header"] },
              "required": { "type": "boolean" },
              "catch_all": { "type": "boolean" }
            }
          }
        },
        "presence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["implemented", "documented", "observed"],
          "properties": {
            "implemented": { "const": true },
            "documented": { "$ref": "#/$defs/evidenceState" },
            "observed": { "$ref": "#/$defs/evidenceState" }
          }
        },
        "controls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["access", "authentication", "authorization", "owner_scope", "tenant_scope"],
          "properties": {
            "access": { "enum": ["public", "authenticated", "privileged", "unknown"] },
            "authentication": { "$ref": "#/$defs/evidenceState" },
            "authorization": { "$ref": "#/$defs/evidenceState" },
            "owner_scope": { "$ref": "#/$defs/evidenceState" },
            "tenant_scope": { "$ref": "#/$defs/evidenceState" }
          }
        },
        "response_fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "sensitivity"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 300 },
              "sensitivity": { "enum": ["public", "internal", "personal", "authorization-metadata", "secret", "unknown"] }
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_id", "path", "sha256"],
          "properties": {
            "source_id": { "type": "string", "pattern": "^sf_web_source_[0-9a-f]{64}$" },
            "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "sha256": { "$ref": "#/$defs/sha256" },
            "line": { "type": "integer", "minimum": 1 }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "reference", "description"],
            "properties": {
              "kind": { "enum": ["code", "build", "documentation", "authorized-traffic", "control", "response"] },
              "reference": { "type": "string", "minLength": 1, "maxLength": 500 },
              "description": { "type": "string", "minLength": 1, "maxLength": 1000 }
            }
          }
        },
        "limitations": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "detail"],
      "properties": {
        "kind": { "enum": ["unsupported-pattern", "file-skipped", "limit-reached", "malformed-input"] },
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "detail": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "evidenceState": { "enum": ["present", "missing", "inconsistent", "unknown", "not-applicable"] }
  }
}
