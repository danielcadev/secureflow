{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SecureFlow automatic-review result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "plan_sha256",
    "started_at",
    "finished_at",
    "status",
    "components",
    "error"
  ],
  "properties": {
    "contract_version": {
      "const": "secureflow-auto-review-result-v1"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "ready-for-review",
        "failed"
      ]
    },
    "components": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "report_sha256",
          "manifest_sha256",
          "case_sha256",
          "candidate_count"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "report_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "case_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "candidate_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "error": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready-for-review"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "error": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
