{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secureflow.local/schemas/secureflow-web-case-v1.schema.json",
  "title": "SecureFlow Web labeled API case v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "case_id", "lineage_group", "split", "license", "routes"],
  "properties": {
    "contract_version": { "const": "secureflow-web-case-v1" },
    "case_id": { "type": "string", "pattern": "^sf_web_case_[0-9a-f]{64}$" },
    "lineage_group": { "type": "string", "minLength": 1, "maxLength": 200 },
    "split": { "enum": ["development", "validation", "holdout", "post-open"] },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "provenance", "license_sha256"],
      "properties": {
        "spdx": { "type": "string", "minLength": 1, "maxLength": 100 },
        "provenance": { "type": "string", "minLength": 1, "maxLength": 500 },
        "license_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/route" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "methods"],
      "properties": {
        "route": { "type": ["string", "null"], "pattern": "^/", "maxLength": 2000 },
        "kind": { "enum": ["api-route", "page-route", "middleware", "server-action"] },
        "methods": {
          "type": "array",
          "maxItems": 7,
          "uniqueItems": true,
          "items": { "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"] }
        }
      }
    }
  }
}
