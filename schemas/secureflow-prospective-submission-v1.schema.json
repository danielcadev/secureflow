{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secureflow.local/schemas/secureflow-prospective-submission-v1.schema.json",
  "title": "SecureFlow prospective per-case submission v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "submission_id", "protocol_id", "dataset_id", "lane_id", "participant_commitment_sha256", "case_id", "attempt_ordinal", "recorded_at", "raw_artifact_sha256", "outcome", "metrics", "claims"],
  "properties": {
    "contract_version": { "const": "secureflow-prospective-submission-v1" },
    "submission_id": { "type": "string", "pattern": "^sf_submission_[0-9a-f]{64}$" },
    "protocol_id": { "type": "string", "pattern": "^sf_protocol_v2_[0-9a-f]{64}$" },
    "dataset_id": { "type": "string", "pattern": "^sf_dataset_[0-9a-f]{64}$" },
    "lane_id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "participant_commitment_sha256": { "$ref": "#/$defs/sha256" },
    "case_id": { "type": "string", "pattern": "^case-[0-9]{4}$" },
    "attempt_ordinal": { "const": 0 },
    "recorded_at": { "type": "string", "format": "date-time" },
    "raw_artifact_sha256": { "$ref": "#/$defs/sha256" },
    "outcome": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "findings"],
          "properties": {
            "kind": { "const": "findings" },
            "findings": {
              "type": "array", "minItems": 1, "maxItems": 100,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["finding_id", "invariant_id", "location", "evidence_sha256", "impact", "repair", "classification", "human_validation_status"],
                "properties": {
                  "finding_id": { "type": "string", "minLength": 1, "maxLength": 100 },
                  "invariant_id": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "location": { "type": "string", "minLength": 1, "maxLength": 500 },
                  "evidence_sha256": { "$ref": "#/$defs/sha256" },
                  "impact": { "type": "string", "minLength": 1, "maxLength": 2000 },
                  "repair": { "type": "string", "minLength": 1, "maxLength": 2000 },
                  "classification": { "const": "candidate" },
                  "human_validation_status": { "const": "pending-independent-adjudication" }
                }
              }
            }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "rationale_sha256", "reviewed_scope_sha256"],
          "properties": {
            "kind": { "const": "no-finding" },
            "rationale_sha256": { "$ref": "#/$defs/sha256" },
            "reviewed_scope_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "reason_code", "rationale_sha256"],
          "properties": {
            "kind": { "const": "abstention" },
            "reason_code": { "enum": ["insufficient-evidence", "unsupported-capability", "ambiguous-trust-boundary", "scope-unclear"] },
            "rationale_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "error_kind", "stage", "detail_sha256"],
          "properties": {
            "kind": { "const": "operational-error" },
            "error_kind": { "enum": ["crash", "timeout", "malformed-output", "unavailable", "infrastructure-failure"] },
            "stage": { "type": "string", "minLength": 1, "maxLength": 200 },
            "detail_sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["analyst_active_time_ns", "wall_clock_time_ns", "cost_microusd", "input_tokens", "output_tokens", "peak_rss_bytes"],
      "properties": {
        "analyst_active_time_ns": { "type": "integer", "minimum": 0 },
        "wall_clock_time_ns": { "type": "integer", "minimum": 1 },
        "cost_microusd": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "peak_rss_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["result_is_independently_adjudicated", "task_bounded_comparative_claim_established", "global_superiority_claim_allowed", "human_replacement_claim_allowed", "production_safety_claim_allowed"],
      "properties": {
        "result_is_independently_adjudicated": { "const": false },
        "task_bounded_comparative_claim_established": { "const": false },
        "global_superiority_claim_allowed": { "const": false },
        "human_replacement_claim_allowed": { "const": false },
        "production_safety_claim_allowed": { "const": false }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
